# ------------------------------------------------------------------
# Supabase  ->  Settings -> API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Samo na serveru. NIKAD u NEXT_PUBLIC_ i nikad u git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------
# Adresa sajta
# Koristi se za PayPal povratne adrese. Ako se ne postavi, cita se iz
# zaglavlja zahteva — dovoljno za lokalni razvoj i Vercel preglede,
# ali u produkciji je bolje da stoji izricito.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tvoj-sajt.vercel.app

# ------------------------------------------------------------------
# PayPal  ->  Developer Dashboard -> Apps & Credentials
# Bez ovoga naplata je iskljucena; aplikacija radi, samo umesto dugmeta
# za placanje pise da paket ide preko pristupnog koda.
# ------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# PayPal -> Webhooks -> id webhook-a koji pokazuje na
# https://tvoj-sajt/api/paypal/webhook
# Bez ovoga se dogadjaji ODBIJAJU. Tako i treba: neproveren dogadjaj
# znaci da svako moze sam sebi da ukljuci paket.
PAYPAL_WEBHOOK_ID=

# sandbox | live
PAYPAL_ENV=sandbox

# Samo za lokalni razvoj bez podesenog webhook-a: dozvoljava obradu
# neproverenih dogadjaja. Radi iskljucivo kad PAYPAL_ENV nije "live".
# U produkciji ostaviti prazno.
PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=

# ------------------------------------------------------------------
# Resend  ->  https://resend.com/api-keys
# Sajt salje mejlove za potvrdu naloga i novu lozinku. Bez kljuca se
# nalog pravi odmah potvrdjen, a „zaboravljena lozinka” vraca gresku.
# RESEND_FROM mora biti adresa sa domena potvrdjenog u Resend-u;
# dok domen nije potvrdjen radi samo onboarding@resend.dev.
# ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Euro Fantasy Lab <nalog@eurofantasylab.com>
